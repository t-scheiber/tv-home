# Copy to .env and fill in. .env is git-ignored.
# Values that start with op:// are read with the 1Password CLI at build time. A plain value is used as it is.
# A variable already set in the shell wins over this file.

# Device name registered with ares-setup-device, used by ares-install and ares-launch.
TVH_TV_DEVICE=tv
# Address of the TV, used by tools/tvshot.mjs to reach the Developer Mode inspector.
TVH_TV_HOST=192.0.2.10
# Base URL of Home Assistant, reachable from the TV.
TVH_HA_URL=http://192.0.2.20:8123
# Home Assistant long-lived access token, as a literal value or an op:// reference.
TVH_HA_TOKEN=op://Example Vault/Home Assistant TV token/credential
# input_boolean from ha/tv_home.yaml that lets LG's own home screen through for a while.
TVH_HA_LG_HOME_PASS_ENTITY=input_boolean.tv_lg_home_pass
# Base URL of the Jellyfin server behind the Moonfin row. Leave empty to turn the row off.
TVH_JELLYFIN_URL=https://jellyfin.example.com
# Jellyfin API key, as a literal value or an op:// reference.
TVH_JELLYFIN_API_KEY=op://Example Vault/Jellyfin TV API key/credential
# Jellyfin user whose Continue watching list is shown. Empty means the first administrator.
TVH_JELLYFIN_USER_NAME=
# Jellyfin user ID. If set, the build skips the user lookup against the Jellyfin server.
TVH_JELLYFIN_USER_ID=
# Remote control key that opens the smart home panel, shown as a hint on the home screen.
TVH_PANEL_KEY=1
# App ID of the home screen on the TV (reverse-domain style).
TVH_LAUNCHER_APP_ID=com.example.tvhome
# App ID of the smart home panel on the TV.
TVH_PANEL_APP_ID=com.example.smarthome
# Vendor name written into both apps' appinfo.json.
TVH_VENDOR=Example Vendor
# JSON file with the room, entity, dock and scene configuration. Copy config.example.json to start.
TVH_CONFIG_FILE=config.local.json
# JSON file with the WiFi name, password and QR code. Copy wifi.example.json to start.
TVH_WIFI_FILE=wifi.local.json
